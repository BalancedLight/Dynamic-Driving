<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose paints the whole UI, so the platform theme only needs to supply a window
        background that matches the light/dark scheme while the activity starts.
    -->
    <style name="Theme.DynamicDriving" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/dl_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
