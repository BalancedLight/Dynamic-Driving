    <!-- Onboarding -->
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_done">Start listening</string>
    <string name="onboarding_welcome_title">Music that follows the road</string>
    <string name="onboarding_welcome_body">Dynamic Driving plays layered songs that build and thin out as your speed changes. A demo song, Open Road, is already bundled so you can hear it right away.</string>
    <string name="onboarding_folder_title">Bring your own songs</string>
    <string name="onboarding_folder_body">Point Dynamic Driving at a folder of songs. Each song lives in its own sub-folder with a song.json manifest and its WAV stems. You can do this now or later from the Library tab.</string>
    <string name="onboarding_folder_action">Choose a music folder</string>
    <string name="onboarding_adaptive_title">How adaptive playback works</string>
    <string name="onboarding_adaptive_body">Each song is a set of stems with speed rules. Standing still, the mix is quiet and muffled; as you speed up, layers fade in and overlays drop in and out. You can also drive the mix by hand with a manual speed.</string>
    <string name="onboarding_location_title">Why location may be asked for</string>
    <string name="onboarding_location_body">On a phone that is not connected to a car, your speed comes from GPS. Location is only read while playback is running, it never leaves the device, and Dynamic Driving never requests background location.</string>

