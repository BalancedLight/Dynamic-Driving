    <string name="settings_about_heading">About</string>
    <string name="settings_about_version">Dynamic Driving %1$s</string>
    <string name="settings_about_privacy_title">Your data stays on this device</string>
    <string name="settings_about_privacy_body">Dynamic Driving has no accounts, no analytics, and no network calls. Speed and location samples are used only to shape playback in the moment and are never stored or sent anywhere. Your music folder is read directly from the folder you pick.</string>
    <string name="settings_about_licence">Released under the MIT licence.</string>
